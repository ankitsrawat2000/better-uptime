// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id    String    @id   @default(uuid())
  username    String    @unique
  password   String
  websites   website[] // every user will have multiple websites
}

model website{
  id    String @id    @default(uuid())
  url   String
  time_added DateTime
  ticks    website_tick[]  // Relation: One website has many ticks
  user_id    String
  user    user     @relation(fields: [user_id], references: [id])
}

model region{
  id String @id   @default(uuid())
  name    String
  ticks    website_tick[]   // Relation: One region has many ticks
}

model website_tick {
  id     String @id   @default(uuid())
  response_time_ms    Int
  status      website_status 
  region      region    @relation(fields: [region_id], references: [id]) //Foreign key to the Region model via region_id.
  website     website    @relation(fields: [website_id], references: [id]) //Foreign key to the Website model via website_id.    
  region_id     String
  website_id    String
  createdAt               DateTime    @default(now())
}

enum website_status{
  Up
  Down
  Unknown
}